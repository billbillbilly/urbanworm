# Copy this file to `.env` and fill in your own credentials.
# `.env` is gitignored.
#
# urbanworm reads these via os.getenv when no `key=` argument is passed
# to the dataset functions.

MAPILLARY_API_KEY=
FLICKR_API_KEY=
FREESOUND_API_KEY=

# Optional: hosted Ollama API token (only needed if you don't run Ollama locally)
OLLAMA_API_KEY=
